import random

play_again = "yes"

while play_again == "yes":

    coins = 0

    print("\nYou are in a cave.")
    print("Do you go left or right?")

    choice = input("> ").lower().strip()

    while choice != "left" and choice != "right":
        print("Please type left or right.")
        choice = input("> ").lower().strip()

    if choice == "left":
        print("You found treasure!")
        print("Do you open it or leave it?")

        choice2 = input("> ").lower().strip()

        while choice2 != "open" and choice2 != "leave":
            print("Please type open or leave.")
            choice2 = input("> ").lower().strip()

        if choice2 == "open":
            print("You found 100 gold coins!")
            coins = coins + 100
            print("Coins:", coins)
        else:
            print("You left the treasure behind.")

        print("\nAs you walk deeper into the cave, a dragon appears!")
        print("Do you run or fight?")

        choice3 = input("> ").lower().strip()

        while choice3 != "run" and choice3 != "fight":
            print("Please type run or fight.")
            choice3 = input("> ").lower().strip()

        if choice3 == "fight":
            outcome = random.randint(1, 3)

            if outcome == 1:
                print("You defeated the dragon!")
                coins = coins + 100
                print("You gained 100 more coins!")
            elif outcome == 2:
                print("The dragon tripped on a rock and flew away!")
                coins = coins + 100
                print("You gained 100 more coins!")
            else:
                print("The dragon defeated you. Game over!")

        elif choice3 == "run":
            print("You escaped the dragon and ran home safely.")

    elif choice == "right":
        print("A dragon appears!")
        print("Do you run or fight?")

        choice3 = input("> ").lower().strip()

        while choice3 != "run" and choice3 != "fight":
            print("Please type run or fight.")
            choice3 = input("> ").lower().strip()

        if choice3 == "fight":
            outcome = random.randint(1, 3)

            if outcome == 1:
                print("You defeated the dragon!")
                coins = coins + 100
                print("You gained 100 coins!")
            elif outcome == 2:
                print("The dragon tripped on a rock and got scared. He flew away.")
                coins = coins + 100
                print("You gained 100 coins!")
            else:
                print("The dragon defeated you. Game over!")

        elif choice3 == "run":
            print("You escaped the dragon and ran home safely.")

    print("You ended with", coins, "coins.")

    play_again = input("\nWould you like to play again? (yes/no): ").lower().strip()

    while play_again != "yes" and play_again != "no":
        print("Please type yes or no.")
        play_again = input("Would you like to play again? (yes/no): ").lower().strip()

    if play_again == "yes":
        print("\nStarting a new adventure!")

print("Thanks for playing!")
